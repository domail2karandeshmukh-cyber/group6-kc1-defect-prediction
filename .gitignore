# --- Large archives: exported Docker image and submission ZIP (share separately) ---
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# --- Generated by the trainer (recreate with: docker compose --profile train run --rm trainer) ---
artifacts/*
!artifacts/.gitkeep
*.joblib
*.pkl
*.pickle
mlruns/
mlartifacts/

# --- Local databases (MLflow SQLite store and similar) ---
*.db
*.sqlite
*.sqlite3

# --- Dataset copies (downloaded during training) ---
kc1.csv
*.arff

# --- Credentials and secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.streamlit/secrets.toml

# --- Python, test and notebook caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- Virtual environments ---
.venv/
venv/

# --- Logs and temporary files ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Operating system and editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
